# Kopieren nach .env und ausfüllen:  cp .env.example .env

# Benachrichtigung, mindestens eins davon setzen.
# ntfy: App "ntfy" installieren, dort dieses Thema abonnieren. Name möglichst
# unerratbar wählen, jeder mit dem Namen kann mitlesen.
NTFY_TOPIC=
# Telegram: Bot über @BotFather anlegen, Chat-ID z.B. über @userinfobot holen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Was überwacht wird
CAPACITIES=256,512
STORE_MATCH=München
LOCATION=80331
# Produktseite im Apple Store. Falls Apple die URL anders benennt, hier die
# Adresse aus dem Browser eintragen.
PRODUCT_URL=https://www.apple.com/de/shop/buy-iphone/iphone-duo
# Optional: feste Teilenummern statt automatischer Erkennung, kommagetrennt.
PARTS=

# Sekunden zwischen den Abfragen (Minimum 30). Kürzer bringt kaum was und
# riskiert eine Sperre.
INTERVAL_SEC=90
