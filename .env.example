# Copy to .env and adjust. None of these are required for normal use — the
# miner reads its config from ~/.derpminer (or $DERPMINER_HOME).

# Verbose logging: debug | info | warn | error
DERPMINER_LOG=info

# Override the config/keystore/state home directory.
# DERPMINER_HOME=/path/to/dir

# --- test-only ---
# Run the full clock-out loop against an anvil fork of this upstream RPC.
# FORK_RPC=https://rpc.mainnet.chain.robinhood.com
# Grind a live shift and confirm it via the chain's verifyProof view.
# LIVE_VERIFY=1
# Run the multi-million-hash grind unit tests (slow).
# DERP_SLOW_TESTS=1
